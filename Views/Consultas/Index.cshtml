@model IEnumerable<GestaoConsultasUVV.Models.Consulta>

@{
    ViewData["Title"] = "Minhas Consultas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Minhas Consultas</h2>
            <p class="text-muted mb-0">
                Visualize e gerencie seus agendamentos.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Nova Consulta
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Nenhuma consulta cadastrada.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Especialidade</th>
                        <th>Data e Hora</th>
                        <th>Descrição</th>
                        <th style="width: 180px;">Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var consulta in Model)
                    {
                        <tr>
                            <td>@consulta.Especialidade</td>

                            <td>
                                @consulta.DataHora.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(consulta.Descricao)
                                    ? "-"
                                    : consulta.Descricao)
                            </td>

                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@consulta.Id"
                                   class="btn btn-sm btn-warning">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@consulta.Id"
                                   class="btn btn-sm btn-danger">
                                    Excluir
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>