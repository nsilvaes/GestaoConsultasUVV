@{
    ViewData["Title"] = "Início";
}

<div class="container py-5">

    <div class="row align-items-center">

        <div class="col-lg-7">

            <h1 class="display-4 fw-bold">
                Gestão de Consultas UVV
            </h1>

            <p class="lead text-muted mt-3">
                Sistema desenvolvido em ASP.NET Core MVC para cadastro,
                autenticação de usuários e gerenciamento de consultas.
            </p>

            <p class="text-muted">
                Cadastre-se, acesse sua conta e gerencie seus agendamentos
                de forma simples e segura.
            </p>

            <div class="mt-4">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Consultas"
                       asp-action="Index"
                       class="btn btn-primary btn-lg">
                        Acessar Minhas Consultas
                    </a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Cadastro"
                       class="btn btn-primary btn-lg me-2">
                        Criar Conta
                    </a>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-primary btn-lg">
                        Entrar
                    </a>
                }

            </div>
        </div>

        <div class="col-lg-5 mt-5 mt-lg-0">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h4>Funcionalidades</h4>

                    <ul class="mt-3">
                        <li>Cadastro de usuários</li>
                        <li>Login e logout</li>
                        <li>Cadastro de consultas</li>
                        <li>Listagem de consultas</li>
                        <li>Edição de consultas</li>
                        <li>Exclusão de consultas</li>
                        <li>Rotas protegidas por autenticação</li>
                    </ul>

                </div>
            </div>

        </div>

    </div>

</div>